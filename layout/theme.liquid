```liquid
<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'es' }}">
  <head>
    <meta charset="utf-8">

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1"
    >

    <meta name="theme-color" content="#050505">

    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {{ page_title | escape }}
      {% unless page_title contains shop.name %}
        — {{ shop.name | escape }}
      {% endunless %}
    </title>

    {{ content_for_header }}

    {{ 'am-hero.css' | asset_url | stylesheet_tag }}

    <script
      type="module"
      src="https://unpkg.com/@google/model-viewer@4.1.0/dist/model-viewer.min.js">
    </script>
  </head>

  <body>
    {{ content_for_layout }}

    {{ 'am-hero.js' | asset_url | script_tag }}
  </body>
</html>
```
